APP_ENV=development
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/jale?sslmode=require
INSTALLATION_PEPPER=replace-with-at-least-32-random-characters
ORIGIN_VERIFY_SECRET=replace-with-an-independent-32-character-secret
AUTH_BRIDGE_SECRET=replace-with-an-independent-32-character-secret
AUTH_PORTAL_URL=https://auth.jale.mx
REQUIRE_ORIGIN_VERIFY=true
REQUIRE_APP_INTEGRITY=true
ENABLE_API_DOCS=false

AI_BACKEND=gateway
AI_GATEWAY_URL=https://oficios-ai-adapter.example.workers.dev
AI_GATEWAY_TOKEN=
AI_GATEWAY_TIMEOUT_SECONDS=25
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
PRO_FAIR_USE_MONTHLY=500

GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
DIRECT_ANDROID_PACKAGE=mx.jale.app
PLAY_ANDROID_PACKAGE=mx.jale.app.play
DIRECT_CERTIFICATE_SHA256=
PLAY_CERTIFICATE_SHA256=
DIRECT_VERSION_CODES=1
PLAY_VERSION_CODES=1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_SUCCESS_URL=https://jale.mx/pro/ok
STRIPE_CANCEL_URL=https://jale.mx/pro/cancelado
STRIPE_PORTAL_RETURN_URL=https://jale.mx/pro

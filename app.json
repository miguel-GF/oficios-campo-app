{
  "expo": {
    "name": "Jale",
    "slug": "jale-oficios",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jale",
    "userInterfaceStyle": "light",
    "plugins": [
      ["expo-secure-store", { "configureAndroidBackup": false }],
      "expo-iap",
      "./plugins/withJaleAndroidBackup"
    ],
    "android": {
      "package": "mx.jale.app",
      "versionCode": 1,
      "adaptiveIcon": { "backgroundColor": "#0E5E4A" },
      "permissions": []
    },
    "ios": { "bundleIdentifier": "mx.jale.app", "buildNumber": "1", "supportsTablet": false }
  }
}

{
  "name": "jale-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-build && tsc src/database.ts --outDir .test-build --module commonjs --target es2022 --skipLibCheck && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-camera": "~17.0.8",
    "expo-file-system": "~19.0.23",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
